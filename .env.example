# -----------------------------------------------------------------------------
# External Integration Creator — configuration. Copy to `.env` and fill it in.
# Never commit `.env`: it contains your GitHub token.
# -----------------------------------------------------------------------------

# --- Web server ---------------------------------------------------------------
# Port the app listens on (inside the container).
PORT=3000
# Port published on the host by docker compose.
HOST_PORT=3000
# Sub-path when served behind a reverse proxy, e.g. /gladys-creator
# (leave empty when the app is served at the root of a (sub)domain).
BASE_PATH=
# true ONLY behind a reverse proxy: the client address is then read from the
# last X-Forwarded-For entry (the one the proxy adds). Leave false otherwise:
# a client could fake its address.
TRUST_PROXY=false
# Address the port is published on by docker compose. 127.0.0.1 = this machine
# only (a reverse proxy on the same host). 0.0.0.0 = the whole network (the
# login page protects the app, but prefer HTTPS through a reverse proxy).
BIND_ADDRESS=127.0.0.1
# Domain names the app answers to, comma separated (e.g. creator.example.org,
# *.lan.example.org). IP addresses and localhost always work. Blocks DNS
# rebinding: another site cannot call the app through your browser.
ALLOWED_HOSTS=

# --- Access ------------------------------------------------------------------
# User accounts with a login page (password + 2nd factor: authenticator app
# or passkey). On the first start, a setup code is printed in the logs:
#   docker compose logs external-integration-creator | grep installation
# Optional: APP_PASSWORD (12 characters minimum) creates the first
# administrator (APP_USER) instead. Remove it once logged in.
APP_USER=admin
APP_PASSWORD=
# true = accounts turned off (everybody is administrator). ONLY when an
# authenticating reverse proxy (Pangolin, Authelia...) protects the app and
# the port is not reachable directly.
NO_PASSWORD=false
# Session: maximum length (days) and logout after inactivity (hours).
SESSION_DAYS=7
SESSION_IDLE_HOURS=12
# Public address, e.g. https://creator.example.org. Only needed for passkeys
# when the reverse proxy does not send X-Forwarded-Host / X-Forwarded-Proto.
PUBLIC_URL=

# --- GitHub ------------------------------------------------------------------
# Fine-grained personal access token (see the README for the exact rights).
# Optional: it can also be pasted in the web page (Réglages), which wins.
GITHUB_TOKEN=

# --- Behaviour ---------------------------------------------------------------
# Simulation mode: every launch step runs, nothing is created anywhere.
DRY_RUN=false
# How long the sources (tracker, store, forum) stay in memory, in minutes.
CACHE_TTL_MINUTES=15
# Live development follow-up: GitHub is polled every N seconds, only while
# a "Développement" page is open.
DEV_POLL_SECONDS=20
# Publication: how often a running workflow is checked, and how long to wait.
PUBLISH_POLL_SECONDS=10
STORE_CHECK_TIMEOUT_MINUTES=15
RELEASE_TIMEOUT_MINUTES=60
# Timeout of each outbound HTTP request, in seconds.
HTTP_TIMEOUT_SECONDS=20
# debug, info, warn or error. Secrets are never written to the logs.
LOG_LEVEL=info

# --- Storage -----------------------------------------------------------------
# Folder of the JSON state file (the docker compose volume ./data -> /data).
DATA_DIR=/data

# --- Sources (change only for tests or a mirror) -----------------------------
# TRACKER_BASE_URL=https://william-de71.github.io/gladys-integrations-tracker
# STORE_BASE_URL=https://integration-store-storage.gladysassistant.com
# FORUM_URL=https://community.gladysassistant.com
# GITHUB_API_URL=https://api.github.com
